VITE_SUPPORT_URL=https://buymeacoffee.com/train_your_unicorn
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxx

# Supabase (create project `tada`, then paste URL + anon/publishable key)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Cloudflare Turnstile site key (secret key goes only in Supabase Auth CAPTCHA settings)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Optional: force Pro outside DEV (DEV already unlocks Pro)
# VITE_DEV_PREMIUM=true

# ElevenLabs — used only by `npm run sounds` (never prefix with VITE_)
# Get a key: https://elevenlabs.io/app/settings/api-keys
# Get a voice id: My Voices → ⋯ → Copy voice ID  https://elevenlabs.io/app/voice-lab
# Then: npm run sounds
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id
